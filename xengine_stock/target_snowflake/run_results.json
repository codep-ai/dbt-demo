{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.9.8", "generated_at": "2026-09-22T06:39:05.088044Z", "invocation_id": "189c5d06-c851-4dd1-853d-7387df487776", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-22T06:39:04.959992Z", "completed_at": "2026-09-22T06:39:04.977335Z"}, {"name": "execute", "started_at": "2026-09-22T06:39:04.978828Z", "completed_at": "2026-09-22T06:39:04.978854Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.02208566665649414, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.stock_xengine.mart_exchange_daily_turnover", "compiled": true, "compiled_code": "-- Daily turnover per exchange in USD. Built BY SNOWFLAKE from Athena-produced tables.\nselect\n    p.exchange,\n    e.country,\n    p.currency_code,\n    p.trade_date,\n    count(distinct p.ticker)        as tickers_traded,\n    sum(p.close_usd * p.volume)     as turnover_usd,\n    sum(p.volume)                   as total_volume\nfrom DATAPAI.STOCK_COMMON.common_price_daily p\njoin DATAPAI.STOCK_COMMON.common_exchange e on e.exchange = p.exchange\nwhere p.close_usd is not null\ngroup by 1, 2, 3, 4", "relation_name": "DATAPAI.STOCK_CONSUMER.mart_exchange_daily_turnover", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-22T06:39:04.971692Z", "completed_at": "2026-09-22T06:39:04.978253Z"}, {"name": "execute", "started_at": "2026-09-22T06:39:04.980089Z", "completed_at": "2026-09-22T06:39:04.980100Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.022269010543823242, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.stock_xengine.mart_price_monthly_usd", "compiled": true, "compiled_code": "-- Finance-facing mart, built BY SNOWFLAKE on tables Athena produced. Small, close to the consumer.\nwith px as (\n    select ticker, exchange, currency_code, trade_date, close, close_usd, volume\n    from DATAPAI.STOCK_COMMON.common_price_daily\n    where close_usd is not null\n),\nranked as (\n    select *,\n           date_trunc('month', trade_date) as month_start,\n           row_number() over (partition by ticker, exchange, date_trunc('month', trade_date) order by trade_date desc) as rn_last\n    from px\n)\nselect\n    r.ticker,\n    r.exchange,\n    t.company_name,\n    t.sector,\n    r.currency_code,\n    cast(r.month_start as date)                     as month_start,\n    count(*)                                        as trading_days,\n    avg(r.close_usd)                                as avg_close_usd,\n    max(case when r.rn_last = 1 then r.close_usd end) as month_end_close_usd,\n    max(case when r.rn_last = 1 then r.close end)     as month_end_close_native,\n    sum(r.volume)                                   as total_volume\nfrom ranked r\nleft join (\n    select ticker, exchange, max(company_name) as company_name, max(sector) as sector\n    from DATAPAI.STOCK_COMMON.common_ticker group by 1, 2\n) t on t.ticker = r.ticker and t.exchange = r.exchange\ngroup by 1, 2, 3, 4, 5, 6", "relation_name": "DATAPAI.STOCK_CONSUMER.mart_price_monthly_usd", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-22T06:39:04.985726Z", "completed_at": "2026-09-22T06:39:05.011495Z"}, {"name": "execute", "started_at": "2026-09-22T06:39:05.012466Z", "completed_at": "2026-09-22T06:39:05.012510Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.03009819984436035, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.stock_xengine.not_null_mart_exchange_daily_turnover_exchange.ed12e9728a", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect exchange\nfrom DATAPAI.STOCK_CONSUMER.mart_exchange_daily_turnover\nwhere exchange is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-